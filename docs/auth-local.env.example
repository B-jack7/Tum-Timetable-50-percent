# Server-only values. Do not put secrets in public/, source control, or client JavaScript.
APP_ORIGIN=https://your-app.example
# D1 is a native binding named DB, not a browser-visible database URL.
# FEED_ENCRYPTION_KEY: set a random key using the deployment secret manager;
# its required encoding/length is defined by the calendar encryption service.
# Do not reuse a password, session token or school credential as this key.

# Official university SAML remains a separate future option, disabled by default.
TUM_SSO_ENABLED=false
TUM_SSO_REGISTRATION_CONFIRMED=false
