{
  "name": "tum-timetable",
  "version": "0.1.0",
  "description": "Tum Timetable: a login-ready personal timetable starter and bilingual NLP practice. University SSO requires approved service configuration.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs dist",
    "preview": "node scripts/serve.mjs dist",
    "start": "node server/index.mjs",
    "auth:start": "node server/index.mjs",
    "test": "node --test",
    "test:auth": "node --test server/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "build": "node scripts/build.mjs",
    "build:static": "node scripts/build.mjs",
    "nlp:rebuild": "node authoring/in2361/rebuild.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.2.0",
    "@xmldom/xmldom": "0.8.15"
  },
  "devDependencies": {
    "selfsigned": "5.5.0",
    "xml-crypto": "6.4.0"
  }
